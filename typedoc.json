{
  "entryPoints": ["src/**/*.ts"],
  "entryPointStrategy": "expand",
  "out": "docs",
  "tsconfig": "tsconfig.json",
  "exclude": [
    "**/*.spec.ts",
    "**/test/**",
    "node_modules",
    "**/node_modules/**/*"
  ],
  "includeVersion": true,
  "themeColor": "#cb9820",
  "plugin": [
    "typedoc-material-theme",
    "./typedoc-swagger-plugin.js",
    "./typedoc-documentation-plugin.js",
    "./typedoc-drawio-plugin.js"
  ],
  "readme": "README.md",

  "name": "Assemble API Documentation",
  "theme": "default",
  "categorizeByGroup": true,
  "categoryOrder": ["Swagger API", "*"]
}
