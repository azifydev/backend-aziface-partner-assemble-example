generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  id               String           @id @default(dbgenerated("(uuid())")) @db.Char(36)
  name             String?          @db.VarChar(255)
  assemble_user_id String?          @db.VarChar(512)
  created_at       DateTime?        @default(now()) @db.Timestamp(0)
  updated_at       DateTime?        @default(now()) @db.Timestamp(0)
  deleted_at       DateTime?        @db.Timestamp(0)
  authentication   authentication[]
  user_data        user_data[]

  @@index([id, deleted_at, name], map: "idx_su_id_deleted_covering")
  @@index([deleted_at], map: "idx_users_deleted_at")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model authentication {
  id         String    @id @default(dbgenerated("(uuid())")) @db.Char(36)
  user_id    String    @db.Char(36)
  username   String    @unique(map: "username") @db.VarChar(255)
  secret     String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  deleted_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_authentication_user_id")

  @@index([user_id], map: "fk_authentication_user_id")
}

model user_data {
  id         String    @id @default(dbgenerated("(uuid())")) @db.Char(36)
  user_id    String    @db.Char(36)
  key        String    @db.VarChar(255)
  value      String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  deleted_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_user_data_user_id")

  @@index([user_id], map: "fk_user_data_user_id")
}
